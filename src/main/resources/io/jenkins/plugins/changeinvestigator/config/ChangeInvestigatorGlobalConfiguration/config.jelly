<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:section title="Build Change Investigator">
    <f:entry title="AI Analysis" field="aiEnabled">
      <f:checkbox title="Enable AI analysis of investigations"/>
    </f:entry>

    <f:entry title="Base URL" field="baseUrl"
             description="OpenAI-compatible API base URL, e.g. https://api.openai.com/v1 - &quot;/chat/completions&quot; is appended automatically.">
      <f:textbox/>
    </f:entry>

    <f:entry title="Model" field="model" description="Model name to request, e.g. gpt-4o-mini.">
      <f:textbox/>
    </f:entry>

    <f:entry title="API Token Credential" field="credentialsId"
             description="A 'Secret text' credential containing the AI provider's API token. The token is never logged or persisted by this plugin outside Jenkins' credential store.">
      <c:select/>
    </f:entry>

    <f:entry title="Max Log Context Characters" field="maxLogContextChars"
             description="Upper bound on how many characters of the (already redacted and reduced) failure log excerpt are sent to the AI provider.">
      <f:number clazz="required number" min="1"/>
    </f:entry>

    <f:entry title="Connection Timeout (seconds)" field="timeoutSeconds">
      <f:number clazz="required number" min="1"/>
    </f:entry>

    <f:entry title="Temperature" field="temperature"
             description="Sampling temperature passed to the model. Kept low by default for consistent, less speculative analysis.">
      <f:number clazz="number" min="0" max="2" step="0.1"/>
    </f:entry>

    <f:advanced>
      <f:entry title="">
        <f:validateButton title="Test Connection" progress="Testing..." method="testConnection"
                           with="baseUrl,model,credentialsId,timeoutSeconds"/>
      </f:entry>
    </f:advanced>

    <f:block>
      <div class="jenkins-!-color-secondary">
        AI analysis sends the observed evidence bundle (job/build metadata, SCM changes, and a
        redacted log excerpt - never full console output, credentials, or workspace files) to the
        configured endpoint. Review your organization's data handling policies before enabling this
        with an external provider. See SECURITY.md in the plugin repository for details.
      </div>
    </f:block>
  </f:section>
</j:jelly>
