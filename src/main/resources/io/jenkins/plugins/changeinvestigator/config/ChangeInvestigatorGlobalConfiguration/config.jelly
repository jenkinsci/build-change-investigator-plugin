<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="Build Change Investigator">
    <f:optionalBlock name="aiEnabled" field="aiEnabled" inline="true"
                      title="Enable AI analysis of investigations">

      <f:entry title="AI Provider" field="providerConfig">
        <f:dropdownDescriptorSelector field="providerConfig" title="AI Provider"/>
      </f:entry>

      <f:entry title="">
        <f:validateButton title="Test Connection" progress="Testing..." method="testConnection" with=""/>
      </f:entry>
      <f:block>
        <div class="jenkins-!-color-secondary">
          Test Connection checks the saved configuration - save this form first, then test.
          It sends only a minimal fixed instruction, never real build evidence.
        </div>
      </f:block>

      <f:advanced>
        <f:entry title="Temperature" field="temperature"
                 description="Sampling temperature passed to the model. Kept low by default for consistent, less speculative analysis.">
          <f:number min="0" max="2" step="0.1"/>
        </f:entry>

        <f:entry title="Connection Timeout (seconds)" field="timeoutSeconds">
          <f:number clazz="positive-number-required" checkMessage="Must be a positive number of seconds." min="1"/>
        </f:entry>

        <f:entry title="Max Log Context Characters" field="maxLogContextChars"
                 description="Upper bound on how many characters of the (already redacted and reduced) failure log excerpt are sent to the AI provider.">
          <f:number clazz="positive-number-required" checkMessage="Must be a positive number of characters." min="1"/>
        </f:entry>
      </f:advanced>

    </f:optionalBlock>

    <f:block>
      <div class="jenkins-!-color-secondary">
        AI analysis sends the observed evidence bundle (job/build metadata, SCM changes, and a
        redacted log excerpt - never full console output, credentials, or workspace files) to the
        configured provider. Review your organization's data handling policies before enabling this
        with an external provider. See SECURITY.md in the plugin repository for details.
      </div>
    </f:block>
  </f:section>
</j:jelly>
