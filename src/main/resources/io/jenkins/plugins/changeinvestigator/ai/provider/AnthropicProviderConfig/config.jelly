<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="Model" field="model"
           description="Model ID, e.g. claude-sonnet-5, claude-opus-5, or claude-haiku-4-5. Any model ID your account has access to is accepted.">
    <f:textbox/>
  </f:entry>

  <f:entry title="Credential" field="credentialsId"
           description="A 'Secret text' credential containing your Anthropic API key. Never logged or persisted outside Jenkins' credential store.">
    <c:select/>
  </f:entry>
</j:jelly>
