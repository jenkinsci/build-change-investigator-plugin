<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="Model" field="model" description="Model ID, e.g. gemini-2.5-flash or gemini-2.5-pro.">
    <f:textbox/>
  </f:entry>

  <f:entry title="Credential" field="credentialsId"
           description="A 'Secret text' credential containing your Gemini API key. Never logged or persisted outside Jenkins' credential store.">
    <c:select/>
  </f:entry>

  <f:advanced>
    <f:entry title="Base URL override" field="baseUrl"
             description="Defaults to https://generativelanguage.googleapis.com - override only for an enterprise proxy or private gateway.">
      <f:textbox/>
    </f:entry>
  </f:advanced>
</j:jelly>
