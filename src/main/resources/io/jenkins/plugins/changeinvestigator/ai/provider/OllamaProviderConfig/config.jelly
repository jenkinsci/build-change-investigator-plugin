<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="Base URL" field="baseUrl"
           description="e.g. http://host.docker.internal:11434/v1 for Docker Desktop, or http://&lt;ollama-host&gt;:11434/v1 for a remote/LAN instance. &quot;localhost&quot; refers to the Jenkins controller/agent itself, which is usually not where Ollama runs.">
    <f:textbox/>
  </f:entry>

  <f:entry title="Model" field="model" description="Model name as pulled in Ollama, e.g. llama3.1.">
    <f:textbox/>
  </f:entry>

  <f:entry title="Credential" field="credentialsId"
           description="A 'Secret text' credential sent as a Bearer token. Optional - Ollama itself does not check authentication; only needed if Ollama is behind a reverse proxy that requires one.">
    <c:select/>
  </f:entry>
</j:jelly>
