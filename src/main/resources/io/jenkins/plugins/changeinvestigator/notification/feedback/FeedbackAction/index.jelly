<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:st="jelly:stapler" xmlns:t="/lib/hudson">
  <j:set var="review" value="${it.feedbackView}"/>
  <l:layout title="Human review - ${it.job.fullDisplayName}">
    <l:side-panel>
      <l:tasks><l:task href="${rootURL}/${it.job.url}" title="Back to project" icon="symbol-arrow-left"/></l:tasks>
      <j:forEach var="widget" items="${it.job.widgets}"><st:include it="${widget}" page="index.jelly"/></j:forEach>
    </l:side-panel>
    <st:adjunct includes="io.jenkins.plugins.changeinvestigator.InvestigationAction.style,io.jenkins.plugins.changeinvestigator.notification.feedback.FeedbackAction.feedback"/>
    <l:main-panel>
      <div class="bci bci-review">
        <div class="bci-label">BUILD CHANGE INVESTIGATION · HUMAN REVIEW</div>
        <h1>Review investigation</h1>
        <j:choose>
          <j:when test="${review ne null}">
            <div class="bci-paragraph">Human judgment adds to the investigation. It does not change the original build evidence.</div>
            <section class="bci-human" aria-label="Current human review">
              <strong>${review.summary}</strong>
              <j:if test="${!empty(review.deliveryWarning)}"><div class="bci-paragraph" role="status">${review.deliveryWarning}</div></j:if>
              <div class="bci-paragraph">${review.confirmationDetail}</div>
              <span class="bci-muted">${review.status} · Review revision ${review.revision} · Evidence revision ${review.evidenceRevision}</span>
              <j:if test="${review.muted}"><div class="bci-paragraph">Notifications muted. Evidence collection continues.</div></j:if>
            </section>
            <div class="bci-boundary">
              <strong>Previous failure #${review.failureLabel} → Recovery build #${review.recoveryLabel}</strong>
              <details><summary>Observed failure evidence</summary><strong>${review.failureLocation}</strong><pre>${review.failureSignal}</pre></details>
              <div class="bci-paragraph bci-muted">Recovery evidence: ${review.recoveryEvidence}. A passing build alone does not confirm a fix.</div>
            </div>
            <j:choose>
              <j:when test="${!empty(review.actions)}">
                <form id="bci-feedback-form" class="no-json" action="${rootURL}/${it.job.url}${it.urlName}/submit" method="post" data-revision="${review.revision}" data-evidence="${review.evidenceRevision}" data-case="${review.caseId}" data-recovery="${review.recoveryBuild}" data-confirmation="${review.confirmationId}">
                  <label for="bci-review-action">Review action</label>
                  <div class="jenkins-select"><select id="bci-review-action" name="action" class="jenkins-select__input">
                    <j:forEach var="option" items="${review.actions}"><option value="${option.value}">${option.label}</option></j:forEach>
                  </select></div>
                  <div id="bci-action-description" class="bci-paragraph bci-muted"></div>
                  <div data-review-fields="REVOKE_CONFIRMATION CORRECT_CONFIRMATION">
                    <label for="bci-confirmation-reference">Confirmation to review</label>
                    <div class="jenkins-select"><select id="bci-confirmation-reference" name="confirmationId" class="jenkins-select__input">
                      <j:forEach var="confirmation" items="${review.confirmations}"><option value="${confirmation.value}" selected="${confirmation.value eq review.confirmationId ? 'selected' : null}" data-resolution="${confirmation.value eq review.resolutionId}">${confirmation.label}</option></j:forEach>
                    </select></div>
                  </div>
                  <div data-review-fields="NOT_RELATED CONFIRM_CAUSE CONFIRM_RESOLUTION CORRECT_CONFIRMATION">
                    <label for="bci-review-candidate">Cause candidate</label>
                    <div class="jenkins-select"><select id="bci-review-candidate" name="candidateId" class="jenkins-select__input">
                      <option value="">No candidate selected</option>
                      <j:forEach var="candidate" items="${review.candidates}"><option value="${candidate.value}">${candidate.label}</option></j:forEach>
                    </select></div>
                    <div class="bci-paragraph bci-muted">Only retained candidates from this investigation can be selected. Original deterministic evidence remains visible.</div>
                  </div>
                  <div data-review-fields="CONFIRM_CAUSE CONFIRM_RESOLUTION CORRECT_CONFIRMATION">
                    <label for="bci-corrective-action">Cause or corrective action</label>
                    <input id="bci-corrective-action" name="correctiveAction" class="jenkins-input" maxlength="400"/>
                    <label for="bci-validation-basis">Validation basis</label>
                    <input id="bci-validation-basis" name="validationBasis" class="jenkins-input" maxlength="400"/>
                    <div class="bci-paragraph bci-muted">These two fields may appear in administrator-approved Slack and email updates. Do not include secrets or private details.</div>
                  </div>
                  <div data-review-fields="REVOKE_CONFIRMATION REOPEN">
                    <label for="bci-revoke-basis">Reason / validation basis</label>
                    <input id="bci-revoke-basis" name="validationBasis" class="jenkins-input" maxlength="400"/>
                    <div class="bci-paragraph bci-muted">This reason may appear in a correction to an earlier notification.</div>
                  </div>
                  <div id="bci-fix-fields" data-review-fields="CONFIRM_RESOLUTION CORRECT_CONFIRMATION">
                    <label for="bci-fix-commit">Fix commit (optional)</label>
                    <input id="bci-fix-commit" name="fixCommit" class="jenkins-input" maxlength="160"/><div class="bci-paragraph bci-muted">If supplied, the commit must match a change retained in the verified recovery evidence.</div>
                  </div>
                  <div data-review-fields="MUTE">
                    <label for="bci-mute-duration">Mute duration</label>
                    <div class="jenkins-select"><select id="bci-mute-duration" name="muteUntil" class="jenkins-select__input"><option value="0">24 hours</option><option value="-1">Until explicitly unmuted</option></select></div>
                    <div class="bci-paragraph bci-muted">Applies to this case's notification destinations. Unmute allows future eligible updates; it does not replay a backlog.</div>
                  </div>
                  <label for="bci-review-note">Private note / reason</label>
                  <input id="bci-review-note" name="note" class="jenkins-input" maxlength="500"/>
                  <div class="bci-paragraph bci-muted">Stored in Jenkins with this review. Not included in Slack or email. Do not enter credentials.</div>
                  <button type="submit" class="jenkins-button jenkins-button--primary">Record human review</button>
                  <div class="bci-paragraph" id="bci-review-result" role="status" aria-live="polite"></div>
                  <a id="bci-review-refresh" href="${rootURL}/${review.url}" hidden="hidden">Refresh and review latest evidence</a>
                </form>
              </j:when>
              <j:otherwise><div class="bci-paragraph bci-human">Read-only access. An authenticated account with the appropriate BCI permission is required to record human feedback.</div></j:otherwise>
            </j:choose>
            <details class="bci-review-history"><summary>Human review history · ${review.history.size()} records</summary>
              <div class="bci-paragraph bci-muted">Append-only authenticated Jenkins actions. Corrections preserve earlier records.</div>
              <j:forEach var="entry" items="${review.history}">
                <div class="bci-human"><strong>${entry.action}</strong> · ${entry.actor}<div class="bci-paragraph bci-muted">${entry.at} · Review revision ${entry.revision}</div><div class="bci-paragraph">${entry.basis}</div><j:if test="${!empty(entry.note)}"><div class="bci-paragraph">Private note: ${entry.note}</div></j:if></div>
              </j:forEach>
            </details>
          </j:when>
          <j:otherwise><div class="bci-paragraph">Human review is unavailable for this investigation. Historical evidence remains unchanged.</div></j:otherwise>
        </j:choose>
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
