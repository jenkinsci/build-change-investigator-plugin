<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2221.va_045130417c9</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>build-change-investigator</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>hpi</packaging>

  <name>Build Change Investigator</name>
  <description>
    Identifies which change between the last successful build and a failed build
    most likely caused the regression, combining deterministic SCM/log evidence
    with an optional AI assessment.
  </description>
  <!-- Pre-hosting repository location. Once this plugin is accepted for official Jenkins
       hosting (see RELEASE_CHECKLIST.md), the repository moves under the jenkinsci GitHub
       organization and every URL/SCM reference below must be updated to match. -->
  <url>https://github.com/InfraGuard-Labs/build-change-investigator</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>azimsiddiqui</id>
      <name>Azeem Siddiqui</name>
      <email>azimsiddiqui97@gmail.com</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/InfraGuard-Labs/build-change-investigator.git</connection>
    <developerConnection>scm:git:https://github.com/InfraGuard-Labs/build-change-investigator.git</developerConnection>
    <url>https://github.com/InfraGuard-Labs/build-change-investigator</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <jenkins.version>2.568.2</jenkins.version>
    <jenkins.baseline>2.568</jenkins.baseline>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <gitHubRepo>InfraGuard-Labs/build-change-investigator</gitHubRepo>
    <spotbugs.skip>false</spotbugs.skip>
  </properties>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-2.568.x</artifactId>
        <version>6931.vea_a_b_c6fd017d</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Credentials handling for the AI provider API token -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>credentials</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>plain-credentials</artifactId>
    </dependency>

    <!-- Shared Jackson2 databind, wrapped by the Jenkins plugin so we don't
         ship/duplicate our own copy in the classloader -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>jackson2-api</artifactId>
    </dependency>

    <!-- Test-only -->
    <dependency>
      <groupId>org.jenkins-ci.main</groupId>
      <artifactId>jenkins-test-harness</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jenkins-ci.tools</groupId>
        <artifactId>maven-hpi-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>
</project>
