<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2221.va_045130417c9</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>build-change-investigator</artifactId>
  <version>${changelist}</version>
  <packaging>hpi</packaging>

  <name>Build Change Investigator</name>
  <description>Identifies which change between the last successful build and a failed build
    most likely caused the regression, combining deterministic SCM/log evidence
    with an optional AI assessment.</description>
  <url>https://github.com/jenkinsci/${project.artifactId}-plugin</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/${gitHubRepo}</connection>
    <developerConnection>scm:git:https://github.com/${gitHubRepo}</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/${gitHubRepo}</url>
  </scm>

  <properties>
    <changelist>999999-SNAPSHOT</changelist>
    <!-- https://www.jenkins.io/doc/developer/plugin-development/choosing-jenkins-baseline/ -->
    <jenkins.baseline>2.541</jenkins.baseline>
    <jenkins.version>2.541.3</jenkins.version>
    <maven.compiler.release>17</maven.compiler.release>
    <gitHubRepo>jenkinsci/${project.artifactId}-plugin</gitHubRepo>

    <spotless.check.skip>false</spotless.check.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <ban-deprecated-stapler.skip>false</ban-deprecated-stapler.skip>
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
    <banObsoleteDependencyOverrides.skip>false</banObsoleteDependencyOverrides.skip>

    <aws-credentials.version>265.v8422a_f384cd9</aws-credentials.version>
    <!-- Pinned to exactly the AWS SDK v2 version the "Amazon Web Services SDK 2 :: Core"
         Jenkins plugin (aws-java-sdk2-core, a transitive dependency of aws-credentials above)
         currently bundles - confirmed via that plugin's own update-center metadata, and the only
         version it offers as of this writing. This is not a coincidence: aws-credentials pulls
         aws-java-sdk2-core in as a real Jenkins plugin dependency, so its classes for shared
         "software.amazon.awssdk.*" packages (aws-core, sdk-core, utils, regions, ...) are visible
         to - and resolved ahead of - this plugin's own bundled copies of those same packages.
         Bundling a newer AWS SDK version here than aws-java-sdk2-core provides is a genuine
         production bug, not just a theoretical risk: bedrockruntime classes compiled against a
         newer AwsClientEndpointProvider API were found (via a real Jenkins 2.541.3 instance) to
         link against aws-java-sdk2-core's older, incompatible class at runtime, throwing
         java.lang.NoSuchMethodError from inside BedrockRuntimeClient.builder().build() on every
         single Bedrock call. Keeping this version aligned with aws-java-sdk2-core's is the fix;
         if aws-java-sdk2-core is ever updated, bump this to match at the same time. -->
    <aws-sdk.version>2.42.33</aws-sdk.version>
    <!-- The AWS SDK v2 modules the Bedrock provider needs (bedrockruntime, url-connection-client)
         are plain (non-plugin) jars, so the hpi-maven-plugin bundles them, along with their own
         minimal required transitive dependencies, directly into this plugin's .hpi.
         hpi.strictBundledArtifacts (above) requires this list to be declared explicitly rather
         than silently accepting whatever a dependency bump changes it to; this exact list is
         what `mvn verify` itself reports as actually bundled, after excluding both bedrockruntime's
         default apache5-client/netty-nio-client transports (unused - BedrockProvider always
         supplies its own url-connection-client) and aws-credentials' own unrelated transitive
         EC2 SDK trees (unused - only AmazonWebServicesCredentials#resolveCredentials is called). -->
    <hpi.bundledArtifacts>annotations,auth,aws-core,aws-json-protocol,aws-query-protocol,bedrockruntime,checksums,checksums-spi,endpoints-spi,eventstream,http-auth,http-auth-aws,http-auth-aws-eventstream,http-auth-spi,http-client-spi,identity-spi,json-utils,metrics-spi,profiles,protocol-core,reactive-streams,regions,retries,retries-spi,sdk-core,slf4j-api,sts,third-party-jackson-core,url-connection-client,utils,utils-lite</hpi.bundledArtifacts>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-2.541.x</artifactId>
        <version>6931.vea_a_b_c6fd017d</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Bedrock's Converse API needs AWS SDK v2, which the Jenkins BOM does not manage
           (it manages only Jenkins plugin coordinates) - imported here so bedrockruntime and
           url-connection-client below resolve to matching, mutually-compatible versions. -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <!-- Provides the "symbol-X plugin-ionicons-api" icon set used on the investigation page -->
    <dependency>
      <groupId>io.jenkins.plugins</groupId>
      <artifactId>ionicons-api</artifactId>
    </dependency>
    <!-- Optional AmazonWebServicesCredentials type for the AWS Bedrock provider - lets an
         admin select a Jenkins-managed AWS key pair instead of relying on the AWS SDK's
         default credential chain (env vars / instance IAM role). Not in the Jenkins BOM at
         this Jenkins baseline, so pinned explicitly; its own required core version
         (2.479.3) is well below this plugin's 2.541.3 baseline.

         Deliberately NOT excluding aws-credentials' own transitive SDK trees
         (io.jenkins.plugins.aws-java-sdk2:aws-java-sdk2-ec2, org.jenkins-ci.plugins.aws-java-sdk:aws-java-sdk-ec2)
         even though this plugin's own code only ever calls
         AmazonWebServicesCredentials#resolveCredentials(String): AWSCredentialsImpl's *own*
         fields (IAM role ARN / assume-role support) reference
         software.amazon.awssdk.services.sts.model.AssumeRoleRequest, which XStream needs to
         resolve whenever a credential of this type is saved - confirmed by an earlier attempt
         at this exclusion failing with NoClassDefFoundError on exactly that class the moment a
         real AWSCredentialsImpl was persisted in a test. Neither of aws-java-sdk2-ec2 nor
         aws-java-sdk-ec2 is itself bundled into this plugin's .hpi regardless (hpi-maven-plugin
         correctly recognizes both as Jenkins plugin dependencies, not raw jars to copy in) - see
         the apache5-client exclusion below for the one raw-jar leak that genuinely needed
         fixing. -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>aws-credentials</artifactId>
      <version>${aws-credentials.version}</version>
    </dependency>
    <!-- Credentials handling for the AI provider API token -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>credentials</artifactId>
    </dependency>

    <!-- Shared Jackson2 databind, wrapped by the Jenkins plugin so we don't
         ship/duplicate our own copy in the classloader -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>jackson2-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>plain-credentials</artifactId>
    </dependency>

    <!-- AWS Bedrock Converse API. The AWS SDK v2 service-client parent POM defaults every
         service module to bundling a synchronous HTTP transport plus netty-nio-client - excluded
         here and replaced with the much lighter blocking url-connection-client, since this
         plugin only ever makes one synchronous call at a time - see BedrockProvider.

         The default sync transport's artifact id depends on the SDK line: current SDK v2
         releases default to "apache5-client" (HttpClient 5), but this plugin is intentionally
         pinned to 2.42.33 (see aws-sdk.version above, for classloader compatibility with the
         aws-java-sdk2-core Jenkins plugin) - and at that older version the default is still
         "apache-client", the legacy HttpClient 4-based module, which is what actually needs
         excluding here. If aws-sdk.version is ever bumped back up past the point where AWS
         switched the default, this exclusion's artifactId must be changed back to
         "apache5-client" (verify against the actual RequireUpperBoundDeps/dependency:tree
         output for the target version rather than assuming). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>bedrockruntime</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- AWS STS AssumeRole support for Bedrock's optional Role ARN field (BedrockProvider) -
         StsAssumeRoleCredentialsProvider only, never a hand-signed request. Same excluded
         default transport as bedrockruntime above (see the comment there for why it is
         "apache-client" rather than "apache5-client" at the currently-pinned SDK version); sts
         shares the rest of its transitive closure (sdk-core, auth, regions, ...) with
         bedrockruntime already, at the identical BOM-managed version, so the net size impact is
         just the sts module itself plus its own XML/query-protocol modules - see the
         dependency-size report for the measured delta. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sts</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.main</groupId>
      <artifactId>jenkins-test-harness</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Test-only -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jenkins-ci.tools</groupId>
        <artifactId>maven-hpi-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>
</project>
